      "source": [
        "## 3.3 Matriks Probabilitas Transisi dan Perpindahan State"
      ],
      "metadata": {
        "id": "1O7oxXeI8tey"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Matriks Frekuensi Transisi (nᵢⱼ)\n",
        "df['Next_State_Code'] = df.groupby('Customer_ID')['State_Code'].shift(-1)\n",
        "transitions = df.dropna(subset=['Next_State_Code']).copy()\n",
        "transitions['Next_State_Code'] = transitions['Next_State_Code'].astype(int)\n",
        "\n",
        "transition_count = pd.crosstab(\n",
        "    transitions['State_Code'],\n",
        "    transitions['Next_State_Code']\n",
        ")\n",
        "transition_count.index   = state_order\n",
        "transition_count.columns = state_order\n",
        "\n",
        "P_df = transition_count.div(transition_count.sum(axis=1), axis=0)\n",
        "P    = P_df.values\n",
        "\n",
        "print(\"\\nMatriks Frekuensi Transisi (nᵢⱼ):\")\n",
        "print(transition_count.to_string())\n",
        "print(f\"\\nTotal transisi: {transition_count.values.sum():,}\")\n",
        "\n",
        "# Matriks Probabilitas Transisi P\n",
        "print(\"\\nMatriks Probabilitas Transisi P (dibulatkan 4 desimal):\")\n",
        "print(pd.DataFrame(np.round(P, 4), index=state_order, columns=state_order).to_string())\n",
        "print(f\"\\nVerifikasi row sums: {P.sum(axis=1).round(6)}\")"
      ],
