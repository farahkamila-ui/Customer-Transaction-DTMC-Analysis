    {
      "cell_type": "code",
      "source": [
        "# Pembagian State\n",
        "Q1 = df['Transactions'].quantile(0.25)\n",
        "Q2 = df['Transactions'].quantile(0.50)\n",
        "Q3 = df['Transactions'].quantile(0.75)\n",
        "print(f\"\\nKuartil: Q1={Q1}, Q2={Q2}, Q3={Q3}\")\n",
        "print(\"\"\"\n",
        "Pembagian State:\n",
        "  L  (Low)       : Transactions ≤ Q1\n",
        "  M  (Medium)    : Q1 < Transactions ≤ Q2\n",
        "  H  (High)      : Q2 < Transactions ≤ Q3\n",
        "  VH (Very High) : Transactions > Q3\n",
        "\"\"\")\n",
        "\n",
        "state_order       = ['L', 'M', 'H', 'VH']\n",
        "state_labels_full = ['Low (L)', 'Medium (M)', 'High (H)', 'Very High (VH)']\n",
        "colors            = ['#4e79a7', '#f28e2b', '#59a14f', '#e15759']\n",
        "\n",
        "def assign_state(x):\n",
        "    if pd.isna(x):   return np.nan\n",
        "    elif x <= Q1:    return 'L'\n",
        "    elif x <= Q2:    return 'M'\n",
        "    elif x <= Q3:    return 'H'\n",
        "    else:            return 'VH'\n",
        "\n",
        "df['State'] = df['Transactions'].apply(assign_state)\n",
        "df['State'] = pd.Categorical(df['State'], categories=state_order, ordered=True)\n",
        "df['State_Code'] = df['State'].cat.codes   # L=0, M=1, H=2, VH=3"
      ],
